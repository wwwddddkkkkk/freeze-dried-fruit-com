{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeze-dried-fruit-redirects",
  "account_id": "74d8c4fa6641503fdbf88723ac676905",
  "main": "workers/redirects.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "http://freeze-dried-fruit.com/*",
      "zone_name": "freeze-dried-fruit.com"
    },
    {
      "pattern": "www.freeze-dried-fruit.com",
      "custom_domain": true
    }
  ]
}
